{
  "name": "korn-extension",
  "displayName": "Korn Extension",
  "description": "Sync UI for .r.md markdown files",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "korn",
          "title": "Korn Sync",
          "icon": "media/korn.svg"
        }
      ]
    },
    "views": {
      "korn": [
        {
          "type": "webview",
          "id": "korn.syncView",
          "name": "Sync"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "korn.rmdEditor",
        "displayName": "Korn Markdown",
        "selector": [
          {
            "filenamePattern": "*.r.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "korn.sync",
        "title": "Korn: Sync",
        "icon": "$(sync)"
      },
      {
        "command": "korn.newFile",
        "title": "Korn: New .r.md File",
        "icon": "$(new-file)"
      },
      {
        "command": "korn.openPreview",
        "title": "Korn: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "korn.openPreview",
          "when": "resourceFilename =~ /\\.r\\.md$/ && activeCustomEditorId != 'korn.rmdEditor'",
          "group": "navigation"
        },
        {
          "command": "korn.sync",
          "when": "resourceFilename =~ /\\.r\\.md$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "korn.newFile",
          "when": "view == korn.syncView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "typescript": "^5.6.0"
  }
}
