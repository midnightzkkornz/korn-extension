{
  "name": "korn-extension",
  "displayName": "Korn Markdown Sync",
  "description": "Markdown notes (.r.md) with a toolbar, 4 view modes and one-click Git sync: auto-sync, pull, and a built-in conflict resolver.",
  "publisher": "midnightzkkornz",
  "version": "0.1.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/midnightzkkornz/korn-extension.git"
  },
  "bugs": {
    "url": "https://github.com/midnightzkkornz/korn-extension/issues"
  },
  "homepage": "https://github.com/midnightzkkornz/korn-extension#readme",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "markdown",
    "git",
    "sync",
    "notes",
    "conflict",
    "r.md"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "korn",
          "title": "Korn Sync",
          "icon": "media/korn.svg"
        }
      ]
    },
    "views": {
      "korn": [
        {
          "type": "webview",
          "id": "korn.syncView",
          "name": "Sync"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "korn.rmdEditor",
        "displayName": "Korn Markdown",
        "selector": [
          {
            "filenamePattern": "*.r.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "korn.sync",
        "category": "Korn",
        "title": "Sync",
        "icon": "$(sync)"
      },
      {
        "command": "korn.newFile",
        "category": "Korn",
        "title": "New .r.md File",
        "icon": "$(new-file)"
      },
      {
        "command": "korn.openKorn",
        "category": "Korn",
        "title": "Korn View"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "korn.openKorn",
          "when": "resourceFilename =~ /\\.r\\.md$/ && activeCustomEditorId != 'korn.rmdEditor'",
          "group": "navigation@1"
        },
        {
          "command": "korn.sync",
          "when": "resourceFilename =~ /\\.r\\.md$/",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "korn.newFile",
          "when": "view == korn.syncView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Korn",
      "properties": {
        "korn.autoSync.onSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Sync ไฟล์ `.r.md` ให้เองหลังเซฟ (รอ 2 วินาทีหลังเซฟครั้งล่าสุด)"
        },
        "korn.autoSync.intervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Sync ทุกไฟล์ `.r.md` ที่ยังไม่ sync ทุก N นาที (`0` = ปิด)"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "vscode:prepublish": "npm run clean && npm run compile",
    "compile": "tsc -p ./ && tsc -p webview && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch & tsc -watch -p ./",
    "test": "node test/run.mjs",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@milkdown/kit": "^7.22.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "typescript": "^5.6.0"
  }
}
